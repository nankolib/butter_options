VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=your-key-here

# Optional: override the Pyth Hermes endpoint. Defaults to mainnet
# (`https://hermes.pyth.network`). Set to `https://hermes-beta.pyth.network`
# to use the Beta cluster — only useful if you're testing against feed_ids
# that exist on Beta and your Solana cluster's Wormhole tracks Beta guardians.
#VITE_HERMES_BASE=https://hermes.pyth.network

# PostHog product analytics + session replay (US Cloud).
# Get from your PostHog project settings → Project API key.
# Unset = analytics disabled (no-op, no crashes).
VITE_POSTHOG_KEY=
