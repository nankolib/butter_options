{
  "expo": {
    "name": "opta.",
    "slug": "opta-seeker",
    "scheme": "opta-seeker",
    "icon": "./assets/opta-icon.png",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.opta.seeker",
      "versionCode": 3,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0C0C0A"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
