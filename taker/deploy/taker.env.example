# /opt/opta-taker/.env — root:opta 0640
#
# Copy to /opt/opta-taker/.env on the VPS and fill in OPTA_RPC_URL. Everything
# else below is the shipped default, written out explicitly so the live config is
# readable without cross-referencing src/env.ts.
#
# THE TWO CONSENT FLAGS. A fill requires DRY_RUN=0 AND ARMED=1. They default to
# the safe side in code, so a missing or truncated env file leaves the bot in
# shadow mode rather than live.

OPTA_RPC_URL=
OPTA_TAKER_KEYPAIR=/opt/opta-taker/secrets/taker-keypair.json
OPTA_TAKER_DB=/opt/opta-taker/taker.db

# --- consent -----------------------------------------------------------------
OPTA_TAKER_DRY_RUN=1
OPTA_TAKER_ARMED=0

# --- the band (bps of discount to model fair value) --------------------------
# Below MIN we are not paid for adverse selection; above MAX the price is
# implausible and we decline rather than seize it. See src/eligibility.ts.
OPTA_TAKER_MIN_DISCOUNT_BPS=500
OPTA_TAKER_MAX_DISCOUNT_BPS=5000

# --- budgets (human USDC) ----------------------------------------------------
OPTA_TAKER_MAX_WALLET_DAY_USDC=250
OPTA_TAKER_MAX_GLOBAL_DAY_USDC=2000
OPTA_TAKER_MAX_FLOAT_USDC=10000
OPTA_TAKER_MAX_FILL_USDC=100

# Ceiling on open interest the taker may CREATE via writerAsk fills, measured as
# strike x contracts minted to us. NOT the same thing as MAX_FLOAT: float bounds
# premium paid out (small), this bounds the position we are left holding
# (strike-sized, ~100x larger). Without it the exit problem is effectively
# uncapped, because the float cap would never bind on the minting side.
OPTA_TAKER_MAX_OI_USD=2500

# --- timing ------------------------------------------------------------------
OPTA_TAKER_MIN_DELAY_SECS=30
OPTA_TAKER_MAX_DELAY_SECS=180
OPTA_TAKER_MIN_TTE_SECS=86400
OPTA_TAKER_TICK_MS=60000

OPTA_TAKER_LOW_BALANCE_WARN_SOL=1.0
