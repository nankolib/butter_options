[Unit]
Description=Check the Opta indexer read path is healthy, every 5 minutes
# The refresh cadence is 60s and the staleness threshold is 200s, so a 5-minute
# check detects a wedged or stopped indexer within ~5-8 minutes. Degraded is not
# an outage — the FE falls back to chain scans — so this does not need to be
# tighter, and a tighter check would only add noise.

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=opta-indexer-liveness.service

[Install]
WantedBy=timers.target
