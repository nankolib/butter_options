{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "outDir": "test/out",
    "rootDir": "src",
    "lib": ["ES2020"],
    "types": []
  },
  "include": [
    "src/state/useConnectionState.ts",
    "src/state/sideRider.ts",
    "src/state/errorMessage.ts",
    "src/state/displaySafety.ts",
    "src/state/models.ts"
  ]
}
