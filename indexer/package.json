{
  "name": "opta-indexer",
  "private": true,
  "version": "0.1.0",
  "description": "Opta tape + points engine (Phase 1, SHADOW MODE). TAPE = immutable indexed facts; SCORE = pure recomputable function over the tape. Read the spec header in src/main.ts.",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-idl.js",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && node scripts/run-tests.js",
    "recompute": "node dist/scripts/recompute.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "better-sqlite3": "^11.3.0",
    "bs58": "^5.0.0"
  },
  "overrides": {
    "rpc-websockets": "9.3.7",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.12.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
